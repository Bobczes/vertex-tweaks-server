DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=

# Wymagany. Publiczny adres serwera. Dla hostów innych niż localhost/127.0.0.1/::1 wymagany jest https.
# API_URL=http://localhost:5000
# API_URL=https://twoj-serwer.onrender.com
API_URL=

# Wymagany, losowy sekret: co najmniej 32 bajty. Nie używaj wartości przykładowych.
# Wygeneruj jedną z poniższych komend i wklej wynik (bez cudzysłowów):
#   openssl rand -hex 32
#   [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()
# JWT_SECRET=
JWT_SECRET=

# Opcjonalny ASP.NET Core: port nasłuchiwania (serwer wiąże http://0.0.0.0:PORT).
# PORT=5000
